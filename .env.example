# ── FesFlow — variáveis de ambiente ─────────────────────────
# Copie para .env e preencha com as credenciais do seu projeto Supabase.
# NUNCA commite o .env com valores reais.

# Postgres (Prisma). No Supabase: Project Settings > Database > Connection string.
# Use a porta 6543 (pooler/pgbouncer) para o app e 5432 (direct) para migrações.
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres"

# Supabase Auth + Storage (client-side). Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"

# Chave service_role (server-only, NUNCA expor no client) — usada pelo
# webhook para criar usuários e enviar convites.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# ── Auth + cobrança (Kiwify) ────────────────────────────────
# Liga o login + bloqueio de acesso. Em PRODUÇÃO (NODE_ENV=production) o auth
# é SEMPRE exigido, independente desta flag (fail-closed). Em dev, "false"
# abre em modo demo; use "true" para testar o login localmente.
AUTH_ENABLED="false"
# URL pública do app (usada no link do e-mail de "definir senha"):
NEXT_PUBLIC_APP_URL="https://fesflow.com.br"
# Token do webhook configurado na Kiwify (valida a assinatura HMAC-SHA1):
KIWIFY_WEBHOOK_TOKEN="[token-do-webhook-kiwify]"

# Chave de API do SendGrid (mesma usada no SMTP). O e-mail de acesso é enviado
# DIRETO pela API do SendGrid (não pelo e-mail do Supabase). Remetente:
# acesso@fesflow.com.br (domínio já autenticado no SendGrid).
SENDGRID_API_KEY="[sua-api-key-do-sendgrid]"
